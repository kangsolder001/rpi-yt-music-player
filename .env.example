# ==============================================================================
# RPi YouTube Music Player - Environment Configuration Example
# Copy this file to .env and fill in with your Raspberry Pi credentials:
#   cp .env.example .env
# ==============================================================================

# Target Raspberry Pi SSH login (format: username@ip_address)
PI_TARGET=pi@192.168.1.100

# Raspberry Pi SSH & Sudo password (optional if using SSH keys without sudo password)
PI_PASS=your_password_here

# Target deployment directory on Raspberry Pi (relative to user home)
REMOTE_DIR=rpi-yt-music-player

# Target architecture for Docker buildx (default: linux/arm64 for Pi 4/5)
TARGET_PLATFORM=linux/arm64

